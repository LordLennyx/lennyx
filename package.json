{
  "name": "lennyx",
  "productName": "Lennyx",
  "version": "0.8.1",
  "description": "Lennyx — la to-do list gamifiée. Transforme tes tâches en quêtes épiques.",
  "author": "Lens Daniels <lensdaniels237@gmail.com>",
  "private": true,
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "gen:icon": "node scripts/gen-icon.mjs",
    "gen:sounds": "node scripts/gen-sounds.mjs",
    "electron:dev": "npm run build && electron .",
    "electron:build": "npm run build && npm run gen:icon && electron-builder --win",
    "android:sync": "npm run build && npx cap sync android",
    "ios:sync": "npm run build && npx cap sync ios"
  },
  "dependencies": {
    "@capacitor-community/text-to-speech": "^6.1.0",
    "@capacitor/core": "^7.6.7",
    "@capacitor/local-notifications": "^7.0.7",
    "@capacitor/motion": "^7.0.3",
    "@fontsource/cinzel": "^5.2.8",
    "@fontsource/manrope": "^5.2.8",
    "@supabase/supabase-js": "^2.110.2",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@capacitor/android": "^7.0.0",
    "@capacitor/cli": "^7.0.0",
    "@capacitor/ios": "^7.6.8",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "sharp": "^0.35.3",
    "typescript": "~5.6.3",
    "vite": "^6.0.7"
  },
  "build": {
    "appId": "com.lennyx.app",
    "productName": "Lennyx",
    "files": [
      "dist/**",
      "electron/**"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    }
  }
}
