<?xml version="1.0" encoding="utf-8"?>
<!--
  L'écran de réveil : la photo de l'utilisateur en plein cadre, l'heure, et deux
  boutons. Lennyx ne fait que signer l'ensemble — un filet or et son nom en
  petit —, l'image reste la vedette.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/lennyx_ink">

    <ImageView
        android:id="@+id/alarm_background"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:contentDescription="@null" />

    <View
        android:id="@+id/alarm_scrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/alarm_scrim"
        android:visibility="gone" />

    <!-- Le cadre discret, en retrait des bords -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_margin="14dp"
        android:background="@drawable/alarm_frame" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingStart="30dp"
        android:paddingEnd="30dp"
        android:paddingTop="46dp"
        android:paddingBottom="42dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="LENNYX"
            android:textColor="@color/lennyx_gold"
            android:textSize="12sp"
            android:letterSpacing="0.42"
            android:fontFamily="serif"
            android:alpha="0.85" />

        <View
            android:layout_width="34dp"
            android:layout_height="1dp"
            android:layout_marginTop="10dp"
            android:background="@color/lennyx_gold_dim" />

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/alarm_clock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="00:00"
            android:textColor="@color/lennyx_text"
            android:textSize="78sp"
            android:letterSpacing="0.06"
            android:fontFamily="serif"
            android:shadowColor="#CC000000"
            android:shadowDx="0"
            android:shadowDy="2"
            android:shadowRadius="14" />

        <TextView
            android:id="@+id/alarm_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="DEBOUT, CONQUÉRANT"
            android:textColor="@color/lennyx_gold"
            android:textSize="17sp"
            android:letterSpacing="0.16"
            android:fontFamily="serif"
            android:gravity="center"
            android:shadowColor="#CC000000"
            android:shadowDx="0"
            android:shadowDy="2"
            android:shadowRadius="10" />

        <TextView
            android:id="@+id/alarm_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textColor="@color/lennyx_text"
            android:textSize="15sp"
            android:gravity="center"
            android:alpha="0.9"
            android:shadowColor="#CC000000"
            android:shadowDx="0"
            android:shadowDy="2"
            android:shadowRadius="10" />

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <Button
            android:id="@+id/alarm_stop"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="JE SUIS DEBOUT"
            android:textColor="@color/lennyx_ink"
            android:textSize="16sp"
            android:textStyle="bold"
            android:letterSpacing="0.1"
            android:background="@drawable/alarm_btn_primary"
            android:stateListAnimator="@null" />

        <Button
            android:id="@+id/alarm_snooze"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="12dp"
            android:text="+5 min"
            android:textColor="@color/lennyx_text"
            android:textSize="15sp"
            android:letterSpacing="0.06"
            android:background="@drawable/alarm_btn_ghost"
            android:stateListAnimator="@null" />
    </LinearLayout>
</FrameLayout>
