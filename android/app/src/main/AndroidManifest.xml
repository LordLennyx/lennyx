<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:usesCleartextTraffic="true"
        android:theme="@style/AppTheme">

        <!-- ⚠️ MainActivity ne porte PLUS l'intent-filter LAUNCHER : ce sont les
             activity-alias ci-dessous qui le portent, chacun avec son icône
             d'humeur. Un seul est actif à la fois (LennyxIconPlugin).
             Ne JAMAIS désactiver MainActivity : un alias qui pointe vers une
             activité désactivée ne lance plus rien. -->
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true" />

        <!-- ── Les six visages de Lennyx ──────────────────────────────────
             L'icône du lanceur reflète la satisfaction de l'application. Seul
             « serein » est actif à l'installation ; le plugin bascule ensuite.
             Désactiver la fonction dans les Réglages rappelle `reset()`, qui
             remet celui-ci. -->
        <activity-alias
            android:name=".LaunchGlorieux"
            android:targetActivity=".MainActivity"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_glorieux"
            android:roundIcon="@mipmap/ic_launcher_glorieux_round"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".LaunchFier"
            android:targetActivity=".MainActivity"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_fier"
            android:roundIcon="@mipmap/ic_launcher_fier_round"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".LaunchSerein"
            android:targetActivity=".MainActivity"
            android:enabled="true"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_serein"
            android:roundIcon="@mipmap/ic_launcher_serein_round"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".LaunchVigilant"
            android:targetActivity=".MainActivity"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_vigilant"
            android:roundIcon="@mipmap/ic_launcher_vigilant_round"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".LaunchInquiet"
            android:targetActivity=".MainActivity"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_inquiet"
            android:roundIcon="@mipmap/ic_launcher_inquiet_round"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".LaunchEteint"
            android:targetActivity=".MainActivity"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_eteint"
            android:roundIcon="@mipmap/ic_launcher_eteint_round"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>

        <receiver
            android:name=".LennyxWidgetProvider"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/lennyx_widget_info" />
        </receiver>

        <!-- Présence permanente : compte les pas et veille, app fermée ou non.
             stopWithTask=false : balayer Lennyx hors des récentes ne doit pas
             arrêter le comptage, c'est précisément là qu'il sert. -->
        <service
            android:name=".LennyxStepService"
            android:enabled="true"
            android:exported="false"
            android:stopWithTask="false"
            android:foregroundServiceType="health" />

        <!-- Relance la présence au démarrage du téléphone -->
        <receiver
            android:name=".LennyxBootReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- Vérifie toutes les 15 min que la présence tourne encore : les
             surcouches constructeur tuent les services sans prévenir. -->
        <receiver
            android:name=".LennyxWatchdogReceiver"
            android:enabled="true"
            android:exported="false" />

        <!-- ── Réveil et berceuse ─────────────────────────────────────── -->

        <!-- L'écran plein écran, capable de s'afficher par-dessus le verrou.
             excludeFromRecents : un réveil n'a rien à faire dans l'historique.
             showOnLockScreen : autorisation déclarée dès le manifeste. -->
        <activity
            android:name=".LennyxAlarmActivity"
            android:exported="false"
            android:launchMode="singleTask"
            android:excludeFromRecents="true"
            android:showOnLockScreen="true"
            android:turnScreenOn="true"
            android:showWhenLocked="true"
            android:screenOrientation="portrait"
            android:theme="@style/AppTheme.NoActionBar" />

        <!-- Joue l'extrait choisi et pose la notification plein écran -->
        <service
            android:name=".LennyxAlarmService"
            android:enabled="true"
            android:exported="false"
            android:stopWithTask="false"
            android:foregroundServiceType="mediaPlayback" />

        <receiver
            android:name=".LennyxAlarmReceiver"
            android:enabled="true"
            android:exported="false" />

        <!-- Fin de phase du Pomodoro / du chronomètre -->
        <receiver
            android:name=".LennyxTimerReceiver"
            android:enabled="true"
            android:exported="false" />
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Dictée vocale : la reconnaissance tourne sur l'appareil, le micro est
         la seule permission nécessaire. Aucune donnée ne sort. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />

    <!-- Présence permanente -->
    <uses-permission android:name="android.permission.ACTIVITY_RECOGNITION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_HEALTH" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Demandée à l'utilisateur, jamais imposée : sans exemption, One UI
         endort Lennyx et le comptage s'arrête écran éteint. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- Réveil et berceuse : s'imposer par-dessus le verrouillage, jouer le son -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.DISABLE_KEYGUARD" />

    <!-- Le podomètre matériel : sans lui, le comptage en arrière-plan est impossible -->
    <uses-feature android:name="android.hardware.sensor.stepcounter" android:required="false" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />

    <!-- ⚠️ Android 11+ filtre la visibilité des paquets : sans cette
         déclaration, SpeechRecognizer.isRecognitionAvailable() renvoie false
         alors qu'un moteur de reconnaissance est bel et bien installé. -->
    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
    </queries>
</manifest>
